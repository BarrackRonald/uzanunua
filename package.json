{
  "name": "uzanunua",
  "private": true,
  "version": "0.1.0",
  "description": "UzaNunua — AI-native e-commerce & marketplace platform (Kenya-first)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @uzanunua/api prisma:generate",
    "db:migrate": "pnpm --filter @uzanunua/api prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
