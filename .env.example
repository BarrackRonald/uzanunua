# ── General ───────────────────────────────────────────────
NODE_ENV=development

# ── Database (apps/api) ──────────────────────────────────
DATABASE_URL="postgresql://uzanunua:uzanunua_dev@localhost:5432/uzanunua?schema=public"

# ── Redis (apps/api) ──────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Search — Typesense (apps/api) ────────────────────────
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="uzanunua_dev_search_key"

# ── Object storage — S3-compatible / MinIO in dev (apps/api) ─
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="uzanunua-dev"
S3_ACCESS_KEY_ID="uzanunua"
S3_SECRET_ACCESS_KEY="uzanunua_dev_secret"
S3_FORCE_PATH_STYLE="true"

# ── Auth (apps/api) ───────────────────────────────────────
JWT_ACCESS_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Payments — M-Pesa (apps/api) — sandbox creds in dev ──
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_BASE_URL="http://localhost:3001"

# ── Payments — Stripe (apps/api) ─────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AI / LLM provider (apps/api) ─────────────────────────
ANTHROPIC_API_KEY=""

# ── API service (apps/api) ───────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"

# ── Web app (apps/web) ────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
